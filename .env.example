GEMINI_API_KEY=
GEMINI_MODEL_ARCHITECT=gemini-3.5-flash
GEMINI_MODEL_WORKER=gemini-3.5-flash
GEMINI_MODEL_SUPERVISOR=gemini-3.5-flash
GEMINI_TEMPERATURE=0.2
MAX_WORKERS=4
MIN_WORKERS=3
DEFAULT_EXECUTION_TIMEOUT_SECONDS=60
MAX_UPLOADS_PER_MESSAGE=20
MAX_UPLOAD_SIZE_MB=100
EXECUTION_BACKEND=colab
EXECUTION_GATEWAY_URL=
EXECUTION_GATEWAY_TOKEN=

# Chainlit authentication
# Generate a long random value for CHAINLIT_AUTH_SECRET.
CHAINLIT_AUTH_SECRET=
# Bootstrap account. On first successful login, the identity is persisted in SQLite.
UAR_AUTH_USERNAME=
UAR_AUTH_PASSWORD_HASH=
UAR_AUTH_ROLE=user
# Durable identity database. Keep this file outside source control and back it up securely.
UAR_IDENTITY_DB_PATH=runtime_users.db

# Colab execution service
RUNTIME_EXECUTION_TOKEN=
RUNTIME_BIND_HOST=0.0.0.0
RUNTIME_PORT=8000
RUNTIME_ALLOW_NETWORK=false
RUNTIME_PYTHON_POLICY=restricted
RUNTIME_ARTIFACT_ROOT=/content/universal-agent-runtime-artifacts

# Optional Docker execution backend (M27)
DOCKER_IMAGE=python:3.12-alpine
DOCKER_ALLOW_NETWORK=false
DOCKER_MEMORY=512m
DOCKER_CPUS=1.0
DOCKER_PIDS_LIMIT=128
DOCKER_ARTIFACT_ROOT=runtime-docker-artifacts

# M29 live cloud smoke validation
UAR_SMOKE_BASE_URL=
